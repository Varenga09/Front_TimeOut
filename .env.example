# API Configuration
VITE_API_URL=http://localhost:3001/api/v1

# Security Configuration
VITE_ENABLE_2FA=true
VITE_RATE_LIMIT_ATTEMPTS=5
VITE_SESSION_TIMEOUT=24
VITE_ENABLE_CSRF_PROTECTION=true
VITE_ENABLE_SECURITY_HEADERS=true

# Database Configuration (for reference)
# DATABASE_URL=postgresql://user:password@localhost:5432/vitrine
# DATABASE_SSL=false

# JWT Configuration
VITE_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
VITE_JWT_EXPIRES_IN=24h
VITE_JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (for 2FA and verification)
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your-email@gmail.com
VITE_SMTP_PASS=your-app-password
VITE_FROM_EMAIL=noreply@localfood.com

# Security Settings
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000
VITE_PASSWORD_MIN_LENGTH=8
VITE_ENABLE_PASSWORD_COMPLEXITY=true
VITE_ENABLE_ACCOUNT_LOCKOUT=true

# Development Settings
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_DEBUG_MODE=false
